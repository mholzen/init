#!/bin/bash
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "Usage: convert-mov-to-mp4 <file.mov> [file2.mov ...]" >&2
    exit 1
fi

for input in "$@"; do
    if [ ! -f "$input" ]; then
        echo "Cannot convert '$input': file not found" >&2
        exit 1
    fi
    output="${input%.mov}.mp4"
    ffmpeg -i "$input" -c:v libx264 -preset slow -crf 18 -c:a aac -b:a 192k -movflags +faststart "$output"
done
